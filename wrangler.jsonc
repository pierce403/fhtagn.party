{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fhtagn-party",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fhtagn.party/*",
      "zone_name": "fhtagn.party"
    }
  ]
}
